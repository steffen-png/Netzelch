<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14213D"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Kleiner Punkt oben rechts, wenn ein Update bereitliegt -->
    <TextView
        android:id="@+id/updateDot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:contentDescription="Update verfügbar"
        android:padding="8dp"
        android:text="●"
        android:textColor="#FCA311"
        android:textSize="14sp"
        android:visibility="invisible" />

    <!-- Kundenkarte: nimmt den freien Platz ein und steht mittig -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mitgliedskarte"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/qr"
            android:layout_width="244dp"
            android:layout_height="244dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/qr_frame"
            android:padding="12dp"
            android:contentDescription="QR-Code der Kundenkarte"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FCA311"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#E5E5E5"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Bedienung: versteckt, erscheint nach langem Drücken auf die Karte -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

    <Button
        android:id="@+id/pick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Screenshot auswählen" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#C8CCD8"
        android:textSize="14sp" />

    <Button
        android:id="@+id/update"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Erneut prüfen"
        android:visibility="gone" />

    <TextView
        android:id="@+id/device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="#8A93AB"
        android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
